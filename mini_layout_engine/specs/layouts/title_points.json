{
  "layout_id": "title_points",
  "description": "Use for slides with a main title followed by a list of key points, where each point includes a short heading and a supporting description. Suitable for summarizing examples, highlights, or grouped information.",
  "required_fields": [
    "title",
    "point_titles",
    "point_descriptions"
  ],
  "optional_fields": [
    "intro_paragraphs",
    "closing_paragraph",
    "image"
  ],
  "field_types": {
    "title": "string",
    "point_titles": "bullet_list",
    "point_descriptions": "paragraph_list",
    "intro_paragraphs": "paragraph_list",
    "closing_paragraph": "string",
    "image": "image_ref"
  },
  "constraints": {
    "min_points": 2,
    "max_points": 12,
    "require_parallel_lists": true
  },
  "normalization_rules": {
    "trim_strings": true,
    "drop_empty_fields": true,
    "coerce_single_to_list": true,
    "split_lines_for_lists": true
  },
  "hook_key": "title_points.base"
}
